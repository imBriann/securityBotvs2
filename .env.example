# IMPORTANTE: Este es un archivo de ejemplo. NO subir el .env real a git.
# Para usar: Copiar este archivo como app/.env y llenar con tus credenciales reales.

# API de DeepSeek
DEEPSEEK_API_URL="https://api.deepseek.com/v1/chat/completions"
DEEPSEEK_API_KEY="tu-api-key-aqui"

# WhatsApp Business API
VERIFY_TOKEN="tu-verify-token-aqui"
ACCESS_TOKEN="tu-access-token-aqui"
PHONE_NUMBER_ID="tu-phone-number-id-aqui"

# PostgreSQL Configuration
# Formato para Cloud SQL (Google Cloud Run):
# DATABASE_URL="postgresql://USER:PASSWORD@/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE"
# Ejemplo: DATABASE_URL="postgresql://postgres:mipassword@/securitybot?host=/cloudsql/mi-proyecto:us-central1:mi-instancia"
DATABASE_URL="postgresql://usuario:password@/database?host=/cloudsql/proyecto:region:instancia"

# Formato para conexión TCP estándar (desarrollo local):
# DATABASE_URL="postgresql://usuario:password@localhost:5432/database"

# Administración
# Número de teléfono del administrador (sin el símbolo +)
# Ejemplo: 573001234567 para +57 300 123 4567
ADMIN_PHONE_NUMBER="573001234567"
